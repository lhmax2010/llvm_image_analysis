diff --git a/mic/kickstart/custom_commands/micboot.py b/mic/kickstart/custom_commands/micboot.py
index d978be8..b70204b 100644
--- a/mic/kickstart/custom_commands/micboot.py
+++ b/mic/kickstart/custom_commands/micboot.py
@@ -31,6 +31,7 @@ class Mic_Bootloader(F8_Bootloader):
 
         self.menus = ""
         self.ptable = "msdos"
+        self.sparse_tar = False
 
     def _getArgsAsStr(self):
         ret = F8_Bootloader._getArgsAsStr(self)
@@ -39,11 +40,15 @@ class Mic_Bootloader(F8_Bootloader):
             ret += " --menus=%s" %(self.menus,)
         if self.ptable:
             ret += " --ptable=\"%s\"" %(self.ptable,)
+        if getattr(self, 'sparse_tar', False):
+            ret += " --sparse-tar"
         return ret
 
     def _getParser(self):
         op = F8_Bootloader._getParser(self)
         op.add_argument("--menus", dest="menus",version=FC4, help='menus')
         op.add_argument("--ptable", dest="ptable", type=str, version=FC4, help='ptable')
+        op.add_argument("--sparse-tar", action="store_true", dest="sparse_tar",
+                        default=False, version=FC4, help='Use sparse format when archiving with tar')
         return op
 
diff --git a/tools/mic b/tools/mic
index 7b01a1f..71e5173 100755
--- a/tools/mic
+++ b/tools/mic
@@ -99,6 +99,8 @@ def create_parser(parser):
                                     ' achive, extension supported: .zip, .tar, '
                                     '.tar.gz, .tar.bz2, etc. by default, .tar '
                                     'will be used')
+    parent_parser.add_argument('--sparse-tar', action='store_true', dest='sparse_tar',
+                               default=False, help='Archive sparse files with tar -S')
     parent_parser.add_argument('--copy-kernel', action='store_true', dest='copy_kernel',
                                help='Copy kernel files from image /boot directory'
                                     ' to the image output directory.')
