From eadc8fd5c1288206601485c1dbff0ecdb1425bcd Mon Sep 17 00:00:00 2001
From: Jaehoon Chung <jh80.chung@samsung.com>
Date: Wed, 7 Oct 2026 19:31:54 +0900
Subject: [PATCH] Support optional sparse tar archiving via kickstart and CLI

- Add --sparse-tar option to the bootloader command in
  mic/kickstart/custom_commands/micboot.py, allowing kickstart
  files to selectively opt in to sparse tar archiving.
- Add --sparse-tar CLI option to tools/mic and mic/cmd_create.py.
- Pass sparse_tar flag through mic/conf.py and image creators
  (loop, raw, fs) to mic/archive.py.
- Keep standard non-sparse tar (tar -cf) as default to ensure
  100% backward compatibility, while enabling tar -S with
  automatic fallback when --sparse-tar is explicitly specified.

Signed-off-by: Jaehoon Chung <jh80.chung@samsung.com>
---
 mic/archive.py                           | 36 +++++++++++++++---------
 mic/cmd_create.py                        |  3 ++
 mic/conf.py                              |  4 +++
 mic/imager/fs.py                         |  3 ++
 mic/imager/loop.py                       |  2 +-
 mic/imager/raw.py                        |  2 +-
 mic/kickstart/custom_commands/micboot.py |  5 ++++
 tools/mic                                |  2 ++
 8 files changed, 42 insertions(+), 15 deletions(-)

diff --git a/mic/archive.py b/mic/archive.py
index 32672b1..7ea7ac0 100644
--- a/mic/archive.py
+++ b/mic/archive.py
@@ -279,11 +279,12 @@ def decompress(file_path, decompress_format=None):
     return func(file_path, False)
 
 
-def _do_tar(archive_name, target_name):
+def _do_tar(archive_name, target_name, sparse=False):
     """ Archive the directory or the file with 'tar' utility
 
     @archive_name: the name of the tarball file
     @target_name: the name of the target to tar
+    @sparse: whether to enable sparse archiving with tar -S
     @retval: the path of the archived file
     """
     file_list = []
@@ -299,18 +300,21 @@ def _do_tar(archive_name, target_name):
     from mic.utils import misc
     misc.show_tar_diagnostics("/var/tmp")
 
-    # Try creating archive with sparse support (-S) first to save disk space
-    cmdln = ["tar", "-S", "-C", target_dir, "-cf", archive_name]
+    if sparse:
+        cmdln = ["tar", "-S", "-C", target_dir, "-cf", archive_name]
+        cmdln.extend(file_list)
+        (returncode, stdout, stderr) = _call_external(cmdln)
+        if returncode == 0:
+            return archive_name
+        # Fallback without -S if -S is not supported by tar utility
+        msger.warning("tar with -S failed, falling back without -S")
+
+    cmdln = ["tar", "-C", target_dir, "-cf", archive_name]
     cmdln.extend(file_list)
     (returncode, stdout, stderr) = _call_external(cmdln)
     if returncode != 0:
-        # Fallback without -S for tar implementations without sparse support (e.g. toybox tar)
-        cmdln = ["tar", "-C", target_dir, "-cf", archive_name]
-        cmdln.extend(file_list)
-        (returncode, stdout, stderr) = _call_external(cmdln)
-        if returncode != 0:
-            msg = stdout.decode() if isinstance(stdout, bytes) else (stdout or "")
-            raise OSError("Tar command failed: %s (exit code %d): %s" % (" ".join(cmdln), returncode, msg))
+        msg = stdout.decode() if isinstance(stdout, bytes) else (stdout or "")
+        raise OSError("Tar command failed: %s (exit code %d): %s" % (" ".join(cmdln), returncode, msg))
 
     return archive_name
 
@@ -351,19 +355,20 @@ def _imp_tarfile(archive_name, target_name):
     tar.close()
     return archive_name
 
-def _make_tarball(archive_name, target_name, compressor=None):
+def _make_tarball(archive_name, target_name, compressor=None, sparse=False):
     """ Create a tarball from all the files under 'target_name' or itself.
 
     @archive_name: the name of the archived file to create
     @target_name: the directory or the file name to archive
     @compressor: callback function to compress the tarball
+    @sparse: whether to archive with sparse support
     @retval: indicate the compressing result
     """
     archive_dir = os.path.dirname(archive_name)
     tarball_name = tempfile.mktemp(suffix=".tar", dir=archive_dir)
 
     if which("tar") is not None:
-        _do_tar(tarball_name, target_name)
+        _do_tar(tarball_name, target_name, sparse=sparse)
     else:
         _imp_tarfile(tarball_name, target_name)
 
@@ -448,11 +453,12 @@ def get_archive_suffixes():
 
     return suffixes
 
-def make_archive(archive_name, target_name):
+def make_archive(archive_name, target_name, sparse=False):
     """ Create an archive file (eg. tar or zip).
 
     @archive_name: the name of the archived file
     @target_name: the directory or the file to archive
+    @sparse: whether to enable sparse archiving with tar -S
     @retval: the archiving result
     """
     if not os.path.exists(target_name):
@@ -477,6 +483,10 @@ def make_archive(archive_name, target_name):
     if not os.path.exists(archive_dir):
         os.makedirs(archive_dir)
 
+    kwargs = dict(kwargs)
+    if "compressor" in kwargs or func == _make_tarball:
+        kwargs["sparse"] = sparse
+
     return func(archive_name, target_name, **kwargs)
 
 def extract_archive(archive_name, target_name):
diff --git a/mic/cmd_create.py b/mic/cmd_create.py
index ed8a7c9..8e6e49c 100644
--- a/mic/cmd_create.py
+++ b/mic/cmd_create.py
@@ -165,6 +165,9 @@ def main(parser, args, argv):
     if args.pack_to is not None:
         configmgr.create['pack_to'] = args.pack_to
 
+    if args.sparse_tar:
+        configmgr.create['sparse_tar'] = args.sparse_tar
+
     if args.copy_kernel:
         configmgr.create['copy_kernel'] = args.copy_kernel
 
diff --git a/mic/conf.py b/mic/conf.py
index 0666d1f..320c826 100644
--- a/mic/conf.py
+++ b/mic/conf.py
@@ -82,6 +82,7 @@ class ConfigMgr(object):
                     "skip_set_hosts": False,
                     "postscripts_maxruntime": 120,
                     "block_recommends": False,
+                    "sparse_tar": False,
                 },
                 'chroot': {
                     "saveto": None,
@@ -217,6 +218,9 @@ class ConfigMgr(object):
         ks = kickstart.read_kickstart(ksconf)
 
         self.create['ks'] = ks
+        if hasattr(ks.handler, 'bootloader') and getattr(ks.handler.bootloader, 'sparse_tar', False):
+            self.create['sparse_tar'] = True
+
         self.create['name'] = os.path.splitext(os.path.basename(ksconf))[0]
 
         self.create['name'] = misc.build_name(ksconf,
diff --git a/mic/imager/fs.py b/mic/imager/fs.py
index 870bce8..90e5a7b 100644
--- a/mic/imager/fs.py
+++ b/mic/imager/fs.py
@@ -87,6 +87,9 @@ class FsImageCreator(BaseImageCreator):
                                 "--one-file-system",
                                 "--directory",
                                 self._instroot]
+            if getattr(self, 'sparse_tar', False):
+                tar_cmdline.insert(1, "-S")
+
             for ignore_entry in ignores:
