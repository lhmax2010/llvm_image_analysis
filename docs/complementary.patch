+    Return (rc, combined output, stderr). Nonzero rc raises CreatorError,
+    except the first tar -S attempt, whose rc is needed by HQ's fallback.
+    """
+    shell = not isinstance(cmdln_or_args, list)
+    args = shlex.split(cmdln_or_args) if shell else cmdln_or_args
+    command = cmdln_or_args if shell else " ".join(shlex.quote(arg) for arg in args)
+    binary = os.path.basename(args[0]) if args else ""
+    compressors = ("gzip", "pigz", "bzip2", "pbzip2", "lzop", "zstd")
+
+    if binary in compressors and "-d" not in args and len(args) > 1:
+        input_name = os.path.abspath(args[-1])
